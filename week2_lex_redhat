%{
#include <stdio.h>
%}

%%

"int"|"float"|"char"|"double"|"if"|"else"|"for"|"while"|"return"
    { printf("KEYWORD\t\t%s\n", yytext); }

[0-9]+
    { printf("NUMBER\t\t%s\n", yytext); }

[a-zA-Z_][a-zA-Z0-9_]*
    { printf("IDENTIFIER\t%s\n", yytext); }

"=="|"!="|"<="|">="|"<"|">"|"="
    { printf("RELATIONAL/ASSIGN\t%s\n", yytext); }

"+"|"-"|"*"|"/"|"%"
    { printf("ARITHMETIC OPERATOR\t%s\n", yytext); }

";"|","|"("|")"|"{"|"}"
    { printf("SPECIAL SYMBOL\t%s\n", yytext); }

[ \t\n]+
    { /* Ignore white spaces */ }

.
    { printf("UNKNOWN\t\t%s\n", yytext); }

%%

int main()
{
    printf("Enter the source code:\n");
    yylex();

    return 0;
}

int yywrap()
{
    return 1;
}
